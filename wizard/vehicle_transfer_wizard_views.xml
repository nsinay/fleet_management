<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record id="view_vehicle_transfer_wizard_form" model="ir.ui.view">
        <field name="name">vehicle.transfer.wizard.form</field>
        <field name="model">vehicle.transfer.wizard</field>
        <field name="arch" type="xml">

            <form string="Transferir Vehículo">
                <group>
                    <field name="vehicle_id"/>
                    <field name="current_partner_id"/>
                    <field name="new_partner_id"/>
                    <field name="reason"/>
                </group>

                <footer>
                    <button name="action_transfer_vehicle"
                            string="Transferir"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            special="cancel"/>

                </footer>
            </form>
        </field>
    </record>

    <record id="action_vehicle_transfer_wizard" model="ir.actions.act_window">
        <field name="name">Transferir Vehículo</field>
        <field name="res_model">vehicle.transfer.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">
            {
                'default_vehicle_id': active_id
            }
        </field>
    </record>
    
</odoo>